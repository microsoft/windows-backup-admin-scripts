# ---------------------------------------------------------------------------
# .gitignore for windows-backup-admin-scripts (PowerShell / Microsoft Graph)
# ---------------------------------------------------------------------------

# Operating system artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors / IDEs
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.code-workspace
*.swp
*~

# Build / packaging output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Oo]utput/
publish/
*.nupkg
*.snupkg

# Logs and temp files
*.log
*.tmp
*.bak

# Test / coverage results
[Tt]est[Rr]esults/
*.trx
*.coverage
coverage/

# PowerShell secrets / credential material - never commit these
*.pfx
*.cer
*.key
*.pem
secrets.ps1
*.secrets.ps1
*.Credential.xml

# Exported backup data produced by View-WindowsBackup.ps1 (Export = Y).
# The script writes "<user>_windowsbackup_<timestamp>.json" (or .zip) and these
# can contain decoded payloads / user personal data - never commit them.
*_windowsbackup_*.json
*_windowsbackup_*.zip

# Generic export folders, in case a custom -ExportPath points into the repo.
Export/
Exports/
_exported/
